  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the top strip drag and zoom the window, and lets the page ask if it is full screen.",
  "windows": ["main"],
  "permissions": ["core:window:allow-start-dragging", "core:window:allow-toggle-maximize", "core:window:allow-is-fullscreen", "window-state:default"]
}
