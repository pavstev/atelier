{
  // The web app is static files in app/web/dist, served by a Worker with static assets.
  // Deploy only through `mise run deploy` (it checks the account first). The account is pinned:
  // never another account.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "atelier",
  "compatibility_date": "2026-10-01",
  "account_id": "69c9873da4df01aef631792032a43539",
  "workers_dev": false,
  "preview_urls": false,
  // A tiny Worker answers only POST /share (when no service worker took it); every other request
  // is a static file and never runs it.
  "main": "app/web/src/edge/worker.ts",
  "assets": {
    "directory": "app/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/share"],
  },
  "routes": [{ "pattern": "atelier.stevanpavlovic.com", "custom_domain": true }],
}
